{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotserver.local/schema/identification-rollback-v1.json",
  "title": "RobotServer identification rollback manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "configuration_path",
    "configuration_sha256", "profile", "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "robot_identification_rollback"},
    "configuration_path": {"type": "string", "minLength": 1},
    "configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
