<?xml version="1.0"?>
<package format="3">
  <name>robot_identification_ros2</name>
  <version>0.2.1</version>
  <description>ROS 2 recording and session tools for robot parameter identification</description>
  <maintainer email="maintainers@example.com">RobotIdentification contributors</maintainer>
  <license>MIT</license>
  <buildtool_depend>python3-setuptools</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>robot_identification</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>rcl_interfaces</test_depend>
  <test_depend>robot_identification_tools</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
